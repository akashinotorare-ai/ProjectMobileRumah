<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected state (card terpilih) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFDE7" />
            <stroke android:width="2dp" android:color="@color/Yellow" />
            <corners android:radius="16dp" />
            <padding android:bottom="14dp" android:left="16dp" android:right="16dp" android:top="14dp" />
        </shape>
    </item>
    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/Surface" />
            <stroke android:width="1.5dp" android:color="@color/Gray_Light" />
            <corners android:radius="16dp" />
            <padding android:bottom="14dp" android:left="16dp" android:right="16dp" android:top="14dp" />
        </shape>
    </item>
</selector>
