<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/White"
    tools:context=".Quiz.QuizSessionActivity">

    <!-- Header: Tombol Tutup & Progress Bar Soal -->
    <ImageView
        android:id="@+id/btnClose"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="32dp"
        android:contentDescription="Tutup Kuis"
        android:padding="6dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/Gray" />

    <ProgressBar
        android:id="@+id/progressBarQuiz"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_marginHorizontal="16dp"
        android:max="100"
        android:progress="33"
        android:progressTint="@color/Green_Success"
        app:layout_constraintBottom_toBottomOf="@+id/btnClose"
        app:layout_constraintEnd_toStartOf="@+id/tvQuizHeart"
        app:layout_constraintStart_toEndOf="@+id/btnClose"
        app:layout_constraintTop_toTopOf="@+id/btnClose" />

    <TextView
        android:id="@+id/tvQuizHeart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/jetbrainsmono"
        android:text="❤️ 5"
        android:textColor="@color/Red_Error"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/btnClose"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnClose" />

    <!-- Instruksi Soal -->
    <TextView
        android:id="@+id/tvPromptTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/spacegrotesk"
        android:text="Pilih terjemahan yang tepat:"
        android:textColor="@color/Black_Solid"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnClose" />

    <!-- Area Maskot Bangboo & Balon Ucapan Soal -->
    <LinearLayout
        android:id="@+id/layoutQuestionBubble"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvPromptTitle">

        <ImageView
            android:id="@+id/ivMascotQuiz"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:contentDescription="Maskot Bangboo"
            android:src="@drawable/logo_light" />

        <TextView
            android:id="@+id/tvQuestionWord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_rounded_card"
            android:fontFamily="@font/spacegrotesk"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:text="Good Morning (おはよう)"
            android:textColor="@color/Black_Solid"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4 Pilihan Jawaban (MaterialButton) -->
    <LinearLayout
        android:id="@+id/layoutOptions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutQuestionBubble">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOption1"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:text="A. Selamat Siang"
            android:textAlignment="viewStart"
            android:textColor="@color/Black_Solid"
            android:textSize="14sp"
            app:cornerRadius="16dp"
            app:strokeColor="@color/Gray_Light"
            app:strokeWidth="1.5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOption2"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:text="B. Selamat Pagi"
            android:textAlignment="viewStart"
            android:textColor="@color/Black_Solid"
            android:textSize="14sp"
            app:cornerRadius="16dp"
            app:strokeColor="@color/Gray_Light"
            app:strokeWidth="1.5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOption3"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:text="C. Terima Kasih"
            android:textAlignment="viewStart"
            android:textColor="@color/Black_Solid"
            android:textSize="14sp"
            app:cornerRadius="16dp"
            app:strokeColor="@color/Gray_Light"
            app:strokeWidth="1.5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOption4"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:text="D. Selamat Tinggal"
            android:textAlignment="viewStart"
            android:textColor="@color/Black_Solid"
            android:textSize="14sp"
            app:cornerRadius="16dp"
            app:strokeColor="@color/Gray_Light"
            app:strokeWidth="1.5dp" />
    </LinearLayout>

    <!-- Bottom Feedback Sheet (Tampil saat jawaban diperiksa) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D1FADF"
        android:padding="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvFeedbackStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/spacegrotesk"
            android:text="Jawaban Benar! +10 XP 🎉"
            android:textColor="#05603A"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvFeedbackExplanation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:text="Good Morning / おはよう (Ohayou) digunakan sebagai sapaan pagi hari."
            android:textColor="#05603A"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvFeedbackStatus" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextQuestion"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/Green_Success"
            android:fontFamily="@font/spacegrotesk"
            android:text="LANJUTKAN"
            android:textColor="@color/White"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="25dp"
            app:elevation="0dp"
            app:layout_constraintTop_toBottomOf="@+id/tvFeedbackExplanation" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Tombol PERIKSA (saat belum ada feedback) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCheckAnswer"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="28dp"
        android:backgroundTint="@color/Yellow"
        android:fontFamily="@font/spacegrotesk"
        android:text="PERIKSA JAWABAN"
        android:textColor="@color/Black_Solid"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="27dp"
        app:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
