<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/White"
    tools:context=".Home.HomeFragment">

    <!-- Top Status Bar: Bab, Streak, XP (Grand Design Bangbo) -->
    <LinearLayout
        android:id="@+id/topStatusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/White"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Chip Bab -->
        <TextView
            android:id="@+id/chipBab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_status"
            android:fontFamily="@font/spacegrotesk"
            android:text="BAB 1"
            android:textColor="@color/Black_Solid"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Chip Streak Api -->
        <LinearLayout
            android:id="@+id/chipStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip_status"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Streak"
                android:src="@drawable/ic_fire" />

            <TextView
                android:id="@+id/tvStreak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/jetbrainsmono"
                android:text="14 HARI"
                android:textColor="#FF6D00"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Chip XP Kilat -->
        <LinearLayout
            android:id="@+id/chipXp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_status"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="XP"
                android:src="@drawable/ic_xp" />

            <TextView
                android:id="@+id/tvXp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/jetbrainsmono"
                android:text="1,420 XP"
                android:textColor="#0091EA"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content: Target Harian Card & Jalur Belajar Berkelok (Modul 5 NestedScrollView) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewPath"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topStatusBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- Card Target Harian -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardTargetHarian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_card"
                android:padding="16dp"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivTargetIcon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_chip_status"
                    android:contentDescription="Target"
                    android:padding="8dp"
                    android:src="@drawable/ic_nav_target"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/Black_Solid" />

                <TextView
                    android:id="@+id/tvTargetTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="@font/spacegrotesk"
                    android:text="Target Harian: 30 XP"
                    android:textColor="@color/Black_Solid"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/tvTargetProgress"
                    app:layout_constraintStart_toEndOf="@+id/ivTargetIcon"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTargetSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:text="Selesaikan 1 sesi lagi untuk capai streak"
                    android:textColor="@color/Gray"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toStartOf="@+id/tvTargetProgress"
                    app:layout_constraintStart_toEndOf="@+id/ivTargetIcon"
                    app:layout_constraintTop_toBottomOf="@+id/tvTargetTitle" />

                <TextView
                    android:id="@+id/tvTargetProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrainsmono"
                    android:text="20 / 30 XP"
                    android:textColor="@color/Black_Solid"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ProgressBar
                    android:id="@+id/progressBarTarget"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:max="30"
                    android:progress="20"
                    android:progressTint="@color/Yellow"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivTargetIcon" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ================= JALUR BELAJAR BERKELOK (S-CURVE) ================= -->

            <!-- NODE 1 (Selesai): Tata Bahasa -->
            <FrameLayout
                android:id="@+id/node1"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="40dp"
                android:background="@drawable/bg_node_completed"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardTargetHarian">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="3dp"
                    android:contentDescription="Selesai"
                    android:src="@drawable/ic_check" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNode1Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/spacegrotesk"
                android:text="Tata Bahasa"
                android:textColor="@color/Black_Solid"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/node1"
                app:layout_constraintStart_toStartOf="@+id/node1"
                app:layout_constraintTop_toBottomOf="@+id/node1" />

            <!-- Konektor Node 1 ke Node 2 (Miring ke Kiri) -->
            <View
                android:id="@+id/conn1_2"
                android:layout_width="4dp"
                android:layout_height="44dp"
                android:background="@color/Gray_Light"
                android:rotation="30"
                app:layout_constraintEnd_toEndOf="@+id/node1"
                app:layout_constraintStart_toStartOf="@+id/node2"
                app:layout_constraintTop_toBottomOf="@+id/tvNode1Title" />

            <!-- NODE 2 (Selesai): Kosakata (Geser ke Kiri) -->
            <FrameLayout
                android:id="@+id/node2"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_node_completed"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.28"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/conn1_2">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="3dp"
                    android:contentDescription="Selesai"
                    android:src="@drawable/ic_check" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNode2Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/spacegrotesk"
                android:text="Kosakata"
                android:textColor="@color/Black_Solid"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/node2"
                app:layout_constraintStart_toStartOf="@+id/node2"
                app:layout_constraintTop_toBottomOf="@+id/node2" />

            <!-- Konektor Node 2 ke Node 3 (Miring ke Kanan) -->
            <View
                android:id="@+id/conn2_3"
                android:layout_width="4dp"
                android:layout_height="44dp"
                android:background="@color/Gray_Light"
                android:rotation="-35"
                app:layout_constraintEnd_toEndOf="@+id/node3"
                app:layout_constraintStart_toStartOf="@+id/node2"
                app:layout_constraintTop_toBottomOf="@+id/tvNode2Title" />

            <!-- START BADGE di atas Node 3 Aktif -->
            <TextView
                android:id="@+id/badgeStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_start_badge"
                android:fontFamily="@font/spacegrotesk"
                android:text="START!"
                android:textColor="@color/Yellow"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/node3"
                app:layout_constraintEnd_toEndOf="@+id/node3"
                app:layout_constraintStart_toStartOf="@+id/node3" />

            <!-- NODE 3 (Aktif): Perkenalan (Geser ke Kanan) -->
            <FrameLayout
                android:id="@+id/node3"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_node_active"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.65"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/conn2_3">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"
                    android:contentDescription="Mulai"
                    android:src="@drawable/ic_star"
                    app:tint="@color/Black_Solid" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNode3Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/spacegrotesk"
                android:text="Perkenalan"
                android:textColor="@color/Black_Solid"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/node3"
                app:layout_constraintStart_toStartOf="@+id/node3"
                app:layout_constraintTop_toBottomOf="@+id/node3" />

            <!-- Maskot Bangboo Berdiri di Samping Node Aktif -->
            <ImageView
                android:id="@+id/ivFloatingMascot"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:layout_marginStart="16dp"
                android:contentDescription="Maskot Bangboo Cheering"
                android:src="@drawable/logo_light"
                app:layout_constraintBottom_toBottomOf="@+id/node3"
                app:layout_constraintStart_toEndOf="@+id/node3"
                app:layout_constraintTop_toTopOf="@+id/node3" />

            <!-- Konektor Node 3 ke Node 4 (Miring ke Tengah) -->
            <View
                android:id="@+id/conn3_4"
                android:layout_width="4dp"
                android:layout_height="44dp"
                android:background="@color/Gray_Light"
                android:rotation="25"
                app:layout_constraintEnd_toEndOf="@+id/node3"
                app:layout_constraintStart_toStartOf="@+id/node4"
                app:layout_constraintTop_toBottomOf="@+id/tvNode3Title" />

            <!-- NODE 4 (Terkunci): Sapaan (Geser ke Tengah/Kiri) -->
            <FrameLayout
                android:id="@+id/node4"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_node_locked"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/conn3_4">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="3dp"
                    android:contentDescription="Terkunci"
                    android:src="@drawable/ic_lock" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNode4Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/spacegrotesk"
                android:text="Sapaan"
                android:textColor="@color/Gray"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@+id/node4"
                app:layout_constraintStart_toStartOf="@+id/node4"
                app:layout_constraintTop_toBottomOf="@+id/node4" />

            <!-- Konektor Node 4 ke Node 5 -->
            <View
                android:id="@+id/conn4_5"
                android:layout_width="4dp"
                android:layout_height="44dp"
                android:background="@color/Gray_Light"
                android:rotation="-30"
                app:layout_constraintEnd_toEndOf="@+id/node5"
                app:layout_constraintStart_toStartOf="@+id/node4"
                app:layout_constraintTop_toBottomOf="@+id/tvNode4Title" />

            <!-- NODE 5 (Terkunci): Angka &amp; Waktu -->
            <FrameLayout
                android:id="@+id/node5"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_node_locked"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.68"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/conn4_5">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="3dp"
                    android:contentDescription="Terkunci"
                    android:src="@drawable/ic_lock" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNode5Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/spacegrotesk"
                android:text="Angka &amp; Waktu"
                android:textColor="@color/Gray"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@+id/node5"
                app:layout_constraintStart_toStartOf="@+id/node5"
                app:layout_constraintTop_toBottomOf="@+id/node5" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
