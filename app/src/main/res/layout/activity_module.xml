<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/White"
    tools:context=".Module.ModuleActivity">

    <!-- Toolbar dengan Tombol Kembali (Modul 5 Tahap 2 & Modul 7 Tantangan 5.4) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/White"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Card Hafalan Kosakata"
        app:titleTextColor="@color/Black_Solid" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="40dp">

            <!-- Card Hafalan Utama (Grand Design Bangbo) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardFlashcard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_rounded_card"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/ivVocabAvatar"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:contentDescription="Maskot Kosakata"
                    android:src="@drawable/logo_light"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Kata Utama (Sender) -->
                <TextView
                    android:id="@+id/sender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/spacegrotesk"
                    android:text="Good Morning (おはよう)"
                    android:textColor="@color/Black_Solid"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivVocabAvatar" />

                <!-- Teks Bantu Baca (Furigana / Romaji) -->
                <TextView
                    android:id="@+id/tvBantuBacaText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_chip_status"
                    android:fontFamily="@font/jetbrainsmono"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="4dp"
                    android:text="Cara baca: [o-ha-you]"
                    android:textColor="@color/Black_Solid"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/sender" />

                <!-- Arti / Terjemahan (Message) -->
                <TextView
                    android:id="@+id/message"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:gravity="center"
                    android:text="Selamat pagi (sapaan ramah sehari-hari)"
                    android:textColor="@color/Gray"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvBantuBacaText" />

                <View
                    android:id="@+id/dividerCard"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/Gray_Light"
                    app:layout_constraintTop_toBottomOf="@+id/message" />

                <!-- Tombol Aksi: Bantu Baca & Audio Pelafalan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@+id/dividerCard">

                    <!-- Tombol Bantu Baca (Fitur Bahasa Jepang) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBantuBaca"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/spacegrotesk"
                        android:text="BANTU BACA"
                        android:textColor="@color/Black_Solid"
                        android:textSize="11sp"
                        app:cornerRadius="23dp"
                        app:strokeColor="@color/Gray_Light" />

                    <!-- Tombol Audio Listening (Fitur Bahasa Inggris) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAudio"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/spacegrotesk"
                        android:text="🔊 DENGAR"
                        android:textColor="@color/Black_Solid"
                        android:textSize="11sp"
                        app:cornerRadius="23dp"
                        app:strokeColor="@color/Gray_Light" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card Contoh Penggunaan Kalimat -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_rounded_card"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvExampleHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/spacegrotesk"
                    android:text="Contoh Percakapan"
                    android:textColor="@color/Black_Solid"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvExampleSentence"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:text="&quot;Good morning, Tanaka-san! Let's study English and Japanese with Bangbo today!&quot;"
                    android:textColor="@color/Gray"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvExampleHeader" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Tombol Tandai Sudah Dihafal -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkMemorized"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/Yellow"
                android:fontFamily="@font/spacegrotesk"
                android:text="TANDAI SUDAH DIHAFAL (+5 XP)"
                android:textColor="@color/Black_Solid"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="27dp"
                app:elevation="0dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
